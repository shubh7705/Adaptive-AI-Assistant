# ===========================================
# ModelRouter AI - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=modelrouter
DATABASE_URL=postgresql+asyncpg://admin:change_me_in_production@localhost:5432/modelrouter
POSTGRES_READY=true

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Authentication
# Run `python -c "import secrets; print(secrets.token_hex(32))"` to generate a secure key
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated addresses that should receive the admin role when they register.
ADMIN_EMAILS=admin@example.com

# LLM Provider API Keys (at least one is required)
GOOGLE_API_KEY=your_google_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# LangSmith / LangGraph Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ModelRouterAI
